# Environment template for the whole project.
#
# Copy this file to .env for local development, or set the variables in your
# hosting provider's dashboard (Render for the API, Vercel for the web app).
#
# Nothing in this file holds a real secret. Values marked "sync: false" in
# render.yaml and the Vercel project settings are the ones to fill in.

# ---------------------------------------------------------------------------
# Backend API (Render)
# ---------------------------------------------------------------------------

# One connection string is enough. The hosted Postgres providers hand this
# out. Leave it empty to use the separate DB_* settings below instead.
DATABASE_URL=

# Only needed when DATABASE_URL is empty.
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASSWORD=

# Supabase Auth. The API verifies the bearer token the React app sends with
# these values. Staff profiles and roles are recorded without touching
# Supabase, so no service role key is needed.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Browser origins allowed to call the API, comma separated. The local
# development origins are always allowed. A wildcard is refused.
CORS_ORIGINS=http://localhost:5173

# Private storage root for attachments. Leave empty to use
# backend/storage/documents.
DOCUMENT_STORAGE_DIR=

# ---------------------------------------------------------------------------
# Frontend (Vercel)
# ---------------------------------------------------------------------------

# The public Supabase project URL and publishable/anon key. Never put a
# service-role or secret key in the frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The API the frontend calls. In production this is the deployed backend URL.
VITE_API_URL=http://127.0.0.1:8000
