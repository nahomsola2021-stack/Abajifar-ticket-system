# PostgreSQL connection (Supabase project or self-hosted server)
# Set DATABASE_URL on its own, or use the separate settings below.
DATABASE_URL=
DB_HOST=your-db-host
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_database_password

# Supabase Auth (used to verify the bearer token sent by the React app)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key

# Browser origins allowed to call this API, comma separated. The local
# development origins are always allowed. A wildcard is refused because the
# API authenticates with a bearer token.
CORS_ORIGINS=http://localhost:5173

# Private storage root for booking attachments, e-tickets, and identity documents.
# Leave unset to use backend/storage/documents. This directory is never served
# directly; downloads always go through the authenticated API.
DOCUMENT_STORAGE_DIR=

# Supabase privileged service-role key (backend only, never frontend/Git)
SUPABASE_SECRET_KEY=
